{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new-gulfalts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "new-gulfalts.dev", "custom_domain": true },
    { "pattern": "www.new-gulfalts.dev", "custom_domain": true }
  ]
}
